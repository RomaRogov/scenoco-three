<Scene>
  <Background color="#0a0e16" />
  <Fog color="#0a0e16" near="8" far="28" />

  <AmbientLight intensity="0.3" />
  <DirectionalLight intensity="2.5" position="3 5 2" />

  <!-- Two instances of the same prefab, sharing one steel material.
       Turbine_02 overrides its oscillator and tilts its body. -->
  <PrefabInstance src="turbine.prefab.xml" id="Turbine_01" position="0 1 0" />
  <PrefabInstance src="turbine.prefab.xml" id="Turbine_02" position="3 1 0">
    <Override target="#osc" amplitude="1.0" frequency="1.0" />
    <Override target="#body" rotation="0 0 15" />
  </PrefabInstance>

  <!-- Reaches into the instances by scoped id: a component in Turbine_02,
       and the Turbine_01 instance node. -->
  <Mesh id="Indicator" position="6 1 0">
    <SphereGeometry radius="0.3" />
    <MeshStandardMaterial color="#ffcc00" emissive="#ff8800" roughness="0.4" />
    <Components>
      <Follow source="#Turbine_02/osc" axis="0 1 0" scale="2" />
      <LookAt target="#Turbine_01" />
    </Components>
  </Mesh>
</Scene>
