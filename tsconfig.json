{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@scenoco-three/core": ["./packages/core/src/index.ts"],
      "@scenoco-three/core/internal": ["./packages/core/src/internal.ts"],
      "@scenoco-three/core/nodes": ["./packages/core/src/nodes/index.ts"],
      "@scenoco-three/core/nodes/*": ["./packages/core/src/nodes/*"],
      "@scenoco-three/compiler": ["./packages/compiler/src/index.ts"],
      "@scenoco-three/vite": ["./packages/vite/src/index.ts"],
      "@scenoco-three/rapier": ["./packages/rapier/src/index.ts"],
      "@scenoco-three/box2d": ["./packages/box2d/src/index.ts"],
      "@scenoco-three/collision": ["./packages/collision/src/index.ts"],
      "@scenoco-three/audio": ["./packages/audio/src/index.ts"],
      "@scenoco-three/animation": ["./packages/animation/src/index.ts"],
      "@scenoco-three/particles": ["./packages/particles/src/index.ts"],
      "@scenoco-three/particles/compiler": ["./packages/particles/src/compiler.ts"],
      "@scenoco-three/editor": ["./packages/editor/src/index.ts"]
    }
  },
  "include": [
    "tests",
    "packages",
    "examples",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/dist"
  ]
}
