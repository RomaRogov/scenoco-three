<Scene>
  <!-- Dark space background -->
  <Background color="#0a0e16" />

  <!-- Lighting: ambient fill + directional key from front-top -->
  <AmbientLight intensity="0.5" />
  <DirectionalLight intensity="2.5" position="0 8 10" />

  <!--
    Camera: perspective, centred on the game field mid-point (Y=7).
    Placed 20 units along Z, FOV 45° — the ~14-unit tall field fits comfortably
    in view on any 16:9 screen. loadScene() auto-activates the first camera it finds.
  -->
  <PerspectiveCamera id="cam" position="0 7 20" fov="45" near="0.1" far="200" />

  <!-- ─── Walls ──────────────────────────────────────────────────────────────
       Field X runs -8 to +8 (inner faces); walls are 1 unit thick so they sit
       just outside. Field Y runs 0 (paddle zone) to 14 (top wall inner face).
  -->
  <Mesh id="wall_left" position="-8.5 7 0">
    <BoxGeometry width="1" height="14" depth="0.5" />
    <MeshStandardMaterial color="#1e2a44" roughness="0.9" metalness="0.1" />
  </Mesh>

  <Mesh id="wall_right" position="8.5 7 0">
    <BoxGeometry width="1" height="14" depth="0.5" />
    <MeshStandardMaterial color="#1e2a44" roughness="0.9" metalness="0.1" />
  </Mesh>

  <Mesh id="wall_top" position="0 14.5 0">
    <BoxGeometry width="18" height="1" depth="0.5" />
    <MeshStandardMaterial color="#1e2a44" roughness="0.9" metalness="0.1" />
  </Mesh>

  <!-- ─── Paddle ────────────────────────────────────────────────────────────
       Width 3, height 0.4 → half-extents (1.5, 0.2).
       Centre at Y=0.5 so the top face sits at Y=0.7 (comfortable above Y=0).
       halfRange=6.0 keeps the paddle edge 2 units inside the walls (±8 - 1.5 = 6.5,
       minus a small margin so it never visually overlaps the wall mesh).
  -->
  <Mesh id="paddle" position="0 0.5 0">
    <BoxGeometry width="3" height="0.4" depth="0.5" />
    <MeshStandardMaterial color="#38bdf8" emissive="#0c4a6e" roughness="0.2" metalness="0.6" />
    <Components>
      <PaddleController speed="10" halfRange="6.0" />
    </Components>
  </Mesh>

  <!-- ─── Ball ──────────────────────────────────────────────────────────────
       Sphere radius 0.3. The BallController positions it above the paddle on load.
       References resolved before any onLoad runs, so all three refs are live in
       BallController.onLoad().
  -->
  <Mesh id="ball" position="0 1.05 0">
    <SphereGeometry radius="0.3" widthSegments="16" heightSegments="12" />
    <MeshStandardMaterial color="#fb923c" emissive="#7c2d12" roughness="0.25" metalness="0.3" />
    <Components>
      <BallController
        paddle="#paddle"
        bricks="#brick_manager"
        gameManager="#game_manager"
        speed="12" />
    </Components>
  </Mesh>

  <!-- ─── Brick grid ────────────────────────────────────────────────────────
       An invisible Object3D that owns the brick wall. GridLayout stamps the
       brick prefab into a 10×5 grid and tracks the spawned instances — no
       procedural Three.js. The prefab (brick.prefab.xml) carries the brick's
       geometry, material, and <Brick> data; the layout is pure declarative data.
       Origin is cell (row 0, col 0); spacing is the per-column / per-row step.
  -->
  <Object3D id="brick_manager">
    <Components>
      <GridLayout prefab="brick.prefab.xml" cols="10" rows="5"
                  spacing="1.35 0.55" origin="-6.075 7.5 0" />
    </Components>
  </Object3D>

  <!-- ─── Game manager ─────────────────────────────────────────────────────
       Also invisible. Holds score/lives state, drives the HUD overlay, and
       signals restarts. BallController calls back into it; GameManager does NOT
       import BallController (avoiding a circular module graph).
  -->
  <Object3D id="game_manager">
    <Components>
      <GameManager bricks="#brick_manager" startLives="3" />
    </Components>
  </Object3D>
</Scene>
