<Scene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../schema/scene.xsd">
  <Attachments>
    <Background color="#0a0e18" />
    <FogExp2 color="#0a0e18" density="0.028" />
  </Attachments>
  <AmbientLight intensity="0.55" color="#8fa8c8" />
  <DirectionalLight intensity="1.8" position="6 12 -4" color="#fff4e0" />

  <!-- ─── Player ───────────────────────────────────────────────────────────────
       -Z is forward (see PlayerController). The chase camera is a plain child
       node, so it follows lane changes and jump bob for free via the normal
       Three.js parent/child transform — no camera-rig component needed.
  -->
  <Group id="player">
    <Components>
      <PlayerController
        lanes="[-2.4,0,2.4]" forwardSpeed="9" maxSpeed="22" rampRate="0.14"
        jumpImpulse="8.2" gravity="26" slideDuration="0.55" laneChangeDuration="0.16"
        standHeight="0.9" hud="#hud" body="#playerBody"
        sparkleFx="sparkle_burst.prefab.xml" crashFx="crash_burst.prefab.xml" />
      <BoxCollider halfExtents="0.42 0.9 0.42" isSensor="true" />
    </Components>

    <!-- Blocky stylized runner — a few primitives, offset so the (invisible)
         root sits at the collider's center height and this group's origin
         touches the ground. -->
    <Group id="playerBody" position="0 -0.9 0">
      <Mesh position="0 1.1 0">
        <Attachments>
          <BoxGeometry width="0.62" height="0.62" depth="0.36" />
          <MeshStandardMaterial color="#3b82f6" roughness="0.5" metalness="0.15" />
        </Attachments>
      </Mesh>
      <Mesh position="0 1.62 0">
        <Attachments>
          <SphereGeometry radius="0.24" widthSegments="16" heightSegments="12" />
          <MeshStandardMaterial color="#f2c48d" roughness="0.7" />
        </Attachments>
      </Mesh>
      <Mesh position="0 1.15 -0.24">
        <Attachments>
          <BoxGeometry width="0.42" height="0.46" depth="0.2" />
          <MeshStandardMaterial color="#f97316" roughness="0.5" />
        </Attachments>
      </Mesh>
      <Mesh position="-0.16 0.55 0">
        <Attachments>
          <BoxGeometry width="0.22" height="0.7" depth="0.24" />
          <MeshStandardMaterial color="#1f2937" roughness="0.6" />
        </Attachments>
      </Mesh>
      <Mesh position="0.16 0.55 0">
        <Attachments>
          <BoxGeometry width="0.22" height="0.7" depth="0.24" />
          <MeshStandardMaterial color="#1f2937" roughness="0.6" />
        </Attachments>
      </Mesh>
    </Group>

    <Group position="0 -0.85 -0.35">
      <Components><ParticleSystem src="../vfx/dust.particle.xml" /></Components>
    </Group>

    <PerspectiveCamera id="cam" position="0 3.3 7.5" eulerAngles="-18 0 0" fov="62" near="0.1" far="150">
      <!-- ─── HUD (in-canvas UI) ─────────────────────────────────────────────
           pmndrs-uikit flexbox UI as scene nodes. <Fullscreen> fills the
           viewport (child of the camera, uikit convention); the Hud component
           references the elements and drives them via setProperties. The
           RESTART button is a plain Container — Hud receives onPointerClick
           (bubbled from the hit element) and restarts. -->
      <Fullscreen id="hud" color="#e2e8f0" fontWeight="bold">
        <Container width="100%" flexDirection="row" justifyContent="space-between" alignItems="flex-start" padding="18">
          <Container flexDirection="column" alignItems="flex-end">
            <Container flexDirection="row" gap="8" backgroundColor="#0a0e16" backgroundOpacity="0.65" borderRadius="10"
                       paddingTop="8" paddingBottom="8" paddingLeft="16" paddingRight="16">
              <Text text="SCORE" fontSize="20" />
              <Text id="score" text="0" fontSize="20" color="#4af0e0" />
            </Container>
            <Container flexDirection="row" gap="6" marginTop="6">
              <Text text="BEST" fontSize="12" color="#94a3b8" fontWeight="normal" />
              <Text id="bestVal" text="0" fontSize="12" color="#94a3b8" fontWeight="normal" />
            </Container>
          </Container>
          <Container flexDirection="row" gap="8" alignItems="center" backgroundColor="#0a0e16" backgroundOpacity="0.65"
                     borderRadius="10" paddingTop="8" paddingBottom="8" paddingLeft="16" paddingRight="16">
            <Container width="14" height="14" borderRadius="7" backgroundColor="#fbbf24" />
            <Text id="coins" text="0" fontSize="20" color="#fbbf24" />
          </Container>
        </Container>
        <!-- Bottom-center controls hint. -->
        <Container positionType="absolute" positionBottom="16" positionLeft="0" width="100%"
                   flexDirection="row" justifyContent="center">
          <Container backgroundColor="#0a0e16" backgroundOpacity="0.55" borderRadius="8"
                     paddingTop="6" paddingBottom="6" paddingLeft="14" paddingRight="14">
            <Text text="A/D lane - W/Space jump - S slide" fontSize="12" color="#94a3b8" fontWeight="normal" />
          </Container>
        </Container>
        <!-- Game-over panel — hidden until Hud.gameOver() shows it. -->
        <Container id="gameover" display="none" positionType="absolute"
                   positionTop="0" positionRight="0" positionBottom="0" positionLeft="0"
                   flexDirection="column" gap="14" alignItems="center" justifyContent="center"
                   backgroundColor="#080a10" backgroundOpacity="0.72">
          <Text text="CRASHED" fontSize="40" color="#fb7185" letterSpacing="2" />
          <Text id="finalScore" text="Score 0 - 0 coins" fontSize="18" fontWeight="normal" />
          <Container id="restartBtn" backgroundColor="#4af0e0" borderRadius="10"
                     paddingTop="12" paddingBottom="12" paddingLeft="28" paddingRight="28">
            <Text text="RESTART" fontSize="16" color="#04201d" />
          </Container>
        </Container>
        <Components>
          <Hud scoreLabel="#score" bestLabel="#bestVal" coinsLabel="#coins"
               panel="#gameover" finalScoreLabel="#finalScore" restartButton="#restartBtn" />
        </Components>
      </Fullscreen>
    </PerspectiveCamera>
  </Group>

  <!-- ─── Track spawner ──────────────────────────────────────────────────────── -->
  <Group id="spawner">
    <Components>
      <TrackSpawner
        segment="segment.prefab.xml"
        barrier="obstacle_barrier.prefab.xml"
        beam="obstacle_beam.prefab.xml"
        train="obstacle_train.prefab.xml"
        coin="coin.prefab.xml"
        player="#player"
        segmentLength="24" segmentsAhead="5" behindMargin="16"
        safeSegments="2" obstacleChance="0.8" coinChance="0.85" />
    </Components>
  </Group>

</Scene>
