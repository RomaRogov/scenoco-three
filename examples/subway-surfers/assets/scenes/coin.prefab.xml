<!--
  Collectible coin. Single Mesh root (no wrapping Group needed) — TrackSpawner
  spawns it with an explicit y in `position`, and there's no extra baked local
  offset on top of that, unlike the obstacle prefabs.
-->
<Prefab>
  <Mesh eulerAngles="90 0 0">
    <Attachments>
      <CylinderGeometry radiusTop="0.35" radiusBottom="0.35" height="0.08" radialSegments="20" />
      <MeshStandardMaterial color="#fbbf24" emissive="#7a5200" roughness="0.3" metalness="0.7" />
    </Attachments>
    <Components>
      <Coin value="10" />
      <SphereCollider radius="0.42" isSensor="true" />
      <!-- Spin around the vertical (Y) with the flat rotation baked in the Z
           channel preserved — the classic "spinning coin" look, edge-on half the time. -->
      <Tween property="rotation" to="1.5708 6.283 0" duration="1.1" easing="linear" loop="loop" />
    </Components>
  </Mesh>
</Prefab>
