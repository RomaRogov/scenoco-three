<!-- Full-height train — no way through, must change lanes. No wrapper node; the spawned PrefabInstance root is placed, this Mesh keeps its y=1.3 offset. -->
<Prefab
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../schema/prefab.xsd">
  <Mesh position="0 1.3 0">
    <Attachments>
      <BoxGeometry width="1.8" height="2.6" depth="3.2" />
      <MeshStandardMaterial color="#64748b" emissive="#0d1420" roughness="0.4" metalness="0.4" />
    </Attachments>
    <Components>
      <Obstacle kind="dodge" />
      <BoxCollider halfExtents="0.9 1.3 1.6" isSensor="true" />
    </Components>
  </Mesh>
</Prefab>
