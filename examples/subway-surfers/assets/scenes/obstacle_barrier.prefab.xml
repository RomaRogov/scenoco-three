<!--
  Low barrier — jump over it. No wrapper node needed: a spawned prefab is rooted
  at a PrefabInstance, and PrefabAsset.spawn({position}) places *that* root, so
  this Mesh keeps its baked height offset (y=0.3) intact.
-->
<Prefab>
  <Mesh position="0 0.3 0">
    <Attachments>
      <BoxGeometry width="1.7" height="0.6" depth="0.5" />
      <MeshStandardMaterial color="#ef4444" emissive="#3a0a0a" roughness="0.5" metalness="0.15" />
    </Attachments>
    <Components>
      <Obstacle kind="jump" />
      <BoxCollider halfExtents="0.85 0.3 0.25" isSensor="true" />
    </Components>
  </Mesh>
</Prefab>
