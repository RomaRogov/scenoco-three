<!--
  One track chunk: curved ground + two curved side walls + a neon trim strip.
  Five sibling nodes at the prefab root — no hand-written wrapper: a spawned
  prefab is rooted at a PrefabInstance, and the compiler gives a multi-node prefab
  a synthetic Group root, so these compose into one placeable/destroyable unit.
  TrackSpawner spawns them back-to-back ahead of the player, parents each
  segment's obstacles/coins under that root, and one engine.destroy(root) tears
  the whole populated chunk down.
-->
<Prefab
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../schema/prefab.xsd">
  <Mesh eulerAngles="-90 0 0">
    <Attachments>
      <PlaneGeometry width="8.4" height="24" />
      <ShaderMaterial vertex="../shaders/curve.vert" fragment="../shaders/curve.frag">
        <Uniform name="uColor" type="color" value="#5b6b8c" />
        <Uniform name="uCurve" type="float" value="0.0022" />
      </ShaderMaterial>
    </Attachments>
  </Mesh>

  <Mesh position="-4.0 0.8 0">
    <Attachments>
      <BoxGeometry width="0.25" height="1.6" depth="24" />
      <ShaderMaterial vertex="../shaders/curve.vert" fragment="../shaders/curve.frag">
        <Uniform name="uColor" type="color" value="#6d7fa3" />
        <Uniform name="uCurve" type="float" value="0.0022" />
      </ShaderMaterial>
    </Attachments>
  </Mesh>
  <Mesh position="4.0 0.8 0">
    <Attachments>
      <BoxGeometry width="0.25" height="1.6" depth="24" />
      <ShaderMaterial vertex="../shaders/curve.vert" fragment="../shaders/curve.frag">
        <Uniform name="uColor" type="color" value="#6d7fa3" />
        <Uniform name="uCurve" type="float" value="0.0022" />
      </ShaderMaterial>
    </Attachments>
  </Mesh>

  <!-- Neon rail trim — plain (uncurved) emissive strips; at this scale the
       mismatch with the curved wall beneath is imperceptible, and it avoids
       needing a custom emissive variant of the curve shader. -->
  <Mesh position="-4.0 1.62 0">
    <Attachments>
      <BoxGeometry width="0.3" height="0.06" depth="24" />
      <MeshStandardMaterial color="#22d3ee" emissive="#22d3ee" roughness="0.4" />
    </Attachments>
  </Mesh>
  <Mesh position="4.0 1.62 0">
    <Attachments>
      <BoxGeometry width="0.3" height="0.06" depth="24" />
      <MeshStandardMaterial color="#22d3ee" emissive="#22d3ee" roughness="0.4" />
    </Attachments>
  </Mesh>
</Prefab>
