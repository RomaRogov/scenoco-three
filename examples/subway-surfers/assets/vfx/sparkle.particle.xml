<!--
  One-shot coin-pickup sparkle: a quick golden burst, no ongoing emission
  (rateOverTime=0, all particles come from the Burst). Paired with a
  SelfDestruct on the spawning prefab so the burst node cleans itself up.
-->
<ParticleSystem
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="../../schema/particle.xsd" duration="0.5" looping="false" simulationSpace="World"
                startLifetime="0.5" startSpeed="3.5" startSize="0.18"
                startColor="#ffe066" gravityModifier="-0.05">
  <Emission rateOverTime="0">
    <Burst time="0" count="18" />
  </Emission>
  <Shape type="Sphere" radius="0.15" />
  <Renderer renderMode="Billboard" blending="Additive" />
  <ColorOverLifetime colors="[#fff6c8, #ffd23f, #ff9f1c]" />
  <SizeOverLifetime curve="[1, 0.6, 0]" />
</ParticleSystem>
