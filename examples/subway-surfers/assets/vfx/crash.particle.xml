<!-- One-shot crash burst: bigger, hotter, with a little turbulence (Noise). -->
<ParticleSystem
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="../../schema/particle.xsd" duration="0.8" looping="false" simulationSpace="World"
                startLifetime="0.9" startSpeed="6" startSize="0.3"
                startColor="#ff5533" gravityModifier="0.4">
  <Emission rateOverTime="0">
    <Burst time="0" count="40" />
  </Emission>
  <Shape type="Sphere" radius="0.3" />
  <Renderer renderMode="Billboard" blending="Additive" />
  <ColorOverLifetime colors="[#fff2cc, #ff7b25, #7a1f0a]" />
  <SizeOverLifetime curve="[1, 0.8, 0]" />
  <Noise strength="0.6" frequency="1.2" />
</ParticleSystem>
