<!-- An empty field, lit, with a camera looking at the middle of it.

     The shapes to build with are in assets/geometry — the primitives, sized as Unity sizes them.
     A mesh names one and `scale` says how big this one is:

       cube        1 x 1 x 1
       sphere      1 across
       cylinder    1 across, 2 tall     — scale="y: 3" is 6 tall, not 3
       capsule     1 across, 2 tall
       cone        1 across, 1 tall
       quad        1 x 1, standing upright
       plane       10 x 10, standing upright — lay it flat with eulerAngles="x: -90"

     A node's position is the middle of it, so a wall 4 tall standing on the ground is at y: 2. -->
<Scene camera="#camera" background="#8fb7d9">
  <PerspectiveCamera id="camera" fov="45" near="0.1" far="400"
                     position="x: 18; y: 13; z: 20" eulerAngles="x: -24; y: 42" />

  <AmbientLight color="#cfe3f5" intensity="0.8" />
  <DirectionalLight color="#fff4e0" intensity="2.2" position="x: 12; y: 20; z: 8" />

  <!-- The ground: the 10 x 10 plane, laid flat and scaled to 60 across. -->
  <Mesh geometry="../geometry/plane.asset.xml" material="../materials/grass.asset.xml"
        eulerAngles="x: -90" scale="6" />
</Scene>
