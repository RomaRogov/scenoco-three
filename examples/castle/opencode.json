{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "mlx (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "mlx-community/gemma-4-26b-a4b-it-4bit": {
          "name": "gemma-4-26b (local)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "tool_call": true,
          "limit": {
            "context": 7000,
            "output": 3000
          }
        }
      }
    }
  },
  "mcp": {
    "unityMCP": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": false
    },
    "scenoco": {
      "type": "remote",
      "url": "http://127.0.0.1:55470",
      "enabled": true
    }
  },
  "agent": {
    "lean": {
      "description": "Small-model build agent: read, edit, bash, and the scenoco eyes.",
      "mode": "primary",
      "model": "mlx/mlx-community/gemma-4-26b-a4b-it-4bit",
      "prompt": "{file:/private/tmp/claude-502/-Users-romarogov-Dev-scenoco-three/7deaf385-be63-4257-944f-939ba72a3536/scratchpad/lean-prompt.txt}",
      "tools": {
        "read": true,
        "edit": true,
        "write": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "list": false,
        "apply_patch": false,
        "task": false,
        "webfetch": false,
        "websearch": false,
        "lsp": false,
        "skill": false,
        "question": false,
        "todowrite": false,
        "todoread": false,
        "scenoco_telemetry": false,
        "scenoco_play": false,
        "scenoco_pause": false,
        "scenoco_stop": false,
        "scenoco_simulate": false
      }
    }
  }
}
