<!-- GAUNTLET
       3.3.3.3
       .2.2.2.
       1111111
       .2.2.2.
       3.3.3.3
     1 = one hit, 2 = two, 3 = three. A brick's toughness is the only thing a level says about
     it: one prefab, one override, and the material follows from the number. -->
<Scene camera="#camera" background="#05070d" render="../render/neon.render.xml">
  <Systems>
    <!-- No gravity: the ball keeps whatever speed it was given. -->
    <Physics2D gravity="x: 0; y: 0" />
    <GameState levelName="GAUNTLET" />
  </Systems>

  <AmbientLight color="#93c5fd" intensity="1.1" />
  <!-- Key light from the front-right, a cool rim from behind-left: enough shape on a flat field
       of boxes to read as depth without hiding anything. -->
  <DirectionalLight color="#fff7ed" intensity="2.6" position="x: 6; y: 14; z: 16" />
  <DirectionalLight color="#38bdf8" intensity="1.2" position="x: -10; y: 4; z: -8" />
  <PerspectiveCamera id="camera" near="0.1" far="200" position="y: 8.5; z: 24">
    <Components>
      <!-- Keeps the whole 21 x 19.5 playfield on screen at any window shape: the fov is derived
           from the frame, so a narrow phone letterboxes instead of cropping the side walls. -->
      <CameraFit mode="contain" width="21" height="19.5" distance="24" />
    </Components>
  </PerspectiveCamera>

  <Prefab src="arena.prefab.xml">
    <Override target="#ball" speed="18" />
  </Prefab>

  <Prefab src="brick.prefab.xml" position="x: -7.65; y: 14.40"><Override target="#brick" hits="3" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: -2.55; y: 14.40"><Override target="#brick" hits="3" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: 2.55; y: 14.40"><Override target="#brick" hits="3" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: 7.65; y: 14.40"><Override target="#brick" hits="3" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: -5.10; y: 13.40"><Override target="#brick" hits="2" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: 0.00; y: 13.40"><Override target="#brick" hits="2" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: 5.10; y: 13.40"><Override target="#brick" hits="2" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: -7.65; y: 12.40" />
  <Prefab src="brick.prefab.xml" position="x: -5.10; y: 12.40" />
  <Prefab src="brick.prefab.xml" position="x: -2.55; y: 12.40" />
  <Prefab src="brick.prefab.xml" position="x: 0.00; y: 12.40" />
  <Prefab src="brick.prefab.xml" position="x: 2.55; y: 12.40" />
  <Prefab src="brick.prefab.xml" position="x: 5.10; y: 12.40" />
  <Prefab src="brick.prefab.xml" position="x: 7.65; y: 12.40" />
  <Prefab src="brick.prefab.xml" position="x: -5.10; y: 11.40"><Override target="#brick" hits="2" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: 0.00; y: 11.40"><Override target="#brick" hits="2" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: 5.10; y: 11.40"><Override target="#brick" hits="2" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: -7.65; y: 10.40"><Override target="#brick" hits="3" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: -2.55; y: 10.40"><Override target="#brick" hits="3" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: 2.55; y: 10.40"><Override target="#brick" hits="3" /></Prefab>
  <Prefab src="brick.prefab.xml" position="x: 7.65; y: 10.40"><Override target="#brick" hits="3" /></Prefab>
</Scene>
