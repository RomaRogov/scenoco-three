<!-- The furniture every level shares: the walls that bounce, the paddle, the ball, and the
     sensor across the floor. Only the bricks change from level to level, so only the bricks are
     written three times.

     Where each shape and each look is written says how many of it there are. A thing that exists
     once here — the paddle, the ball, the top wall — carries its own, written inside the element
     that uses it. What several nodes share is named as a file, so there is one instance between
     them: the two side walls have one shape, all three walls one material, and the bricks take
     both from files, so a wall of fifty holds one geometry and one material rather than fifty of
     each. That is one upload and one shader, not one draw call — three.js draws a mesh at a
     time, and `InstancedMesh` is what turns many into one call. -->
<Group>
  <!-- Walls. Restitution 1 and no friction: a Breakout ball leaves a wall as fast as it
       arrived and with the mirror angle, which is what makes the rally readable. -->
  <Mesh id="wallLeft" position="x: -9.5; y: 7.5"
        geometry="../geometry/wall-side.asset.xml" material="../materials/wall.asset.xml">
    <Components>
      <RigidBody2D kind="static" />
      <BoxCollider2D halfExtents="x: 0.25; y: 8" restitution="1" friction="0" />
    </Components>
  </Mesh>

  <Mesh id="wallRight" position="x: 9.5; y: 7.5"
        geometry="../geometry/wall-side.asset.xml" material="../materials/wall.asset.xml">
    <Components>
      <RigidBody2D kind="static" />
      <BoxCollider2D halfExtents="x: 0.25; y: 8" restitution="1" friction="0" />
    </Components>
  </Mesh>

  <!-- One top wall, so its shape is written here; the material is the walls' shared one. -->
  <Mesh id="wallTop" position="y: 15.75" material="../materials/wall.asset.xml">
    <BoxGeometry width="19.5" height="0.5" depth="0.9" />
    <Components>
      <RigidBody2D kind="static" />
      <BoxCollider2D halfExtents="x: 9.75; y: 0.25" restitution="1" friction="0" />
    </Components>
  </Mesh>

  <!-- Kinematic: the controller moves the node and the body follows, so the paddle shoves the
       ball rather than being shoved by it. -->
  <Mesh id="paddle" position="y: 1">
    <BoxGeometry width="3.2" height="0.45" depth="0.7" />
    <!-- The paddle glows on its own, wherever it is.

         What decides whether something blooms is its emissive colour **in linear space** times
         `emissiveIntensity`, against the `<Bloom threshold>`. A dark teal like #0d9488 at 1.1
         comes to 0.33 against a threshold of 1 and never blooms by itself. This teal at 1.3 comes
         to 0.86: over the threshold, so it glows at both ends of its travel, and under white, so
         the surface keeps its colour instead of clipping. -->
    <MeshStandardMaterial color="#5eead4" emissive="#2dd4bf" emissiveIntensity="1.3"
                          roughness="0.2" metalness="0.5" />
    <!-- The paddle's own glow, and a child of the paddle so it travels with it. Placed in the
         level instead, it would be a static pool the paddle drives in and out of. A light is a
         node, so the tree is where that is said. -->
    <PointLight color="#fbbf24" intensity="4" distance="11" decay="2" position="y: 0.9; z: 1.2" />
    <Components>
      <Paddle speed="16" halfRange="7.4" />
      <RigidBody2D kind="kinematic" />
      <BoxCollider2D halfExtents="x: 1.6; y: 0.225" restitution="1" friction="0" />
    </Components>
  </Mesh>

  <!-- `bullet` so a fast ball cannot tunnel through a brick between two steps. -->
  <Mesh id="ballBody" position="y: 1.62">
    <SphereGeometry radius="0.32" widthSegments="28" heightSegments="20" />
    <MeshStandardMaterial color="#fef3c7" emissive="#f59e0b" emissiveIntensity="1.4"
                          roughness="0.15" metalness="0.2" />
    <Components>
      <!-- The id is on the component, because that is what a level overrides:
           `<Override target="#ball" speed="18" />` makes level three faster than level one
           without a second copy of this document. -->
      <Ball id="ball" paddle="#paddle" steer="62" speed="15" />
      <RigidBody2D kind="dynamic" bullet="true" gravityScale="0" linearDamping="0" />
      <CircleCollider2D radius="0.32" restitution="1" friction="0" density="1" />
    </Components>
  </Mesh>

  <!-- A sensor, not a wall: it reports the overlap and lets the ball fall through. A <Group>
       rather than an invisible <Mesh> — it is never drawn, so it needs no shape to draw. -->
  <Group id="floor" position="y: -0.6">
    <Components>
      <RigidBody2D kind="static" />
      <BoxCollider2D halfExtents="x: 9.75; y: 0.25" isSensor="true" />
    </Components>
  </Group>
</Group>
