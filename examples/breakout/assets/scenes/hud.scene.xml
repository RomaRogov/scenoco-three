<!-- The HUD, and the run it reports on: score, lives, level.

     A scene of its own, loaded alongside the level and marked dontDestroyOnLoad, so nothing in
     it is rebuilt when a level is. That is what keeps the score across a level change — no
     module-scope singleton, no copying state across the seam.

     It is also the one place that knows the game has three levels, and it can be: no level
     imports this scene, so naming them here is not a cycle. -->
<Scene dontDestroyOnLoad="true">
  <!-- A <Canvas> sizes itself to the camera above it, and this scene draws over the level
       without clearing it — so the HUD is the last thing composited, whatever the level does. -->
  <PerspectiveCamera id="camera" fov="45" near="0.1" far="100">
    <Canvas color="#e2e8f0" fontWeight="bold">
      <!-- Top bar: score on the left, level in the middle, lives on the right. -->
      <Panel anchor="stretchTop" height="58" background="#0d1526" opacity="0.94"
             layout="horizontal" alignX="between" alignY="center" padding="16">
        <Panel layout="horizontal" alignY="center" gap="8">
          <Text text="SCORE" fontSize="11" color="#5b7089" />
          <Text id="score" text="00000" fontSize="22" color="#5eead4" />
        </Panel>

        <Panel layout="horizontal" alignY="center" gap="10">
          <Panel width="6" height="6" radius="3" background="#5eead4" />
          <Text id="level" text="1/3" fontSize="11" color="#8fa3bd" />
          <Panel width="6" height="6" radius="3" background="#5eead4" />
        </Panel>

        <!-- Lives as pips rather than a glyph: the default font has no ♥, and a missing glyph
             draws as a tofu box. A rectangle is a rectangle everywhere. -->
        <Panel layout="horizontal" alignY="center" gap="8">
          <Text text="LIVES" fontSize="11" color="#5b7089" />
          <Panel layout="horizontal" alignY="center" gap="7">
            <Panel id="life1" width="11" height="11" radius="6" background="#fb7185" />
            <Panel id="life2" width="11" height="11" radius="6" background="#fb7185" />
            <Panel id="life3" width="11" height="11" radius="6" background="#fb7185" />
          </Panel>
        </Panel>
      </Panel>

      <!-- Between rounds. `Progress` switches it off while the ball is in play. -->
      <Panel id="banner" anchor="stretch" background="#030509" opacity="0.82"
             layout="vertical" alignX="center" alignY="center" gap="16">
        <Text id="headline" text="" fontSize="46" color="#f8fafc" textAlign="center" />
        <Text id="hint" text="" fontSize="15" color="#7f96b3" fontWeight="normal" textAlign="center" />
      </Panel>

      <Components>
        <Progress levels="[level-1.scene.xml, level-2.scene.xml, level-3.scene.xml]"
                  startingLives="3" pointsPerHit="50"
                  scoreText="#score" levelText="#level"
                  life1="#life1" life2="#life2" life3="#life3"
                  banner="#banner" headline="#headline" hint="#hint" />
      </Components>
    </Canvas>
  </PerspectiveCamera>
</Scene>
