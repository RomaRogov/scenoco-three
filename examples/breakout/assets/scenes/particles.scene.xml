<!--
  Particle system demo (milestone 1) — a Unity-style <ParticleSystem> component.
  The effect emits from its host node; ParticleRenderSystem steps it in play mode
  (like physics), so press play to see it. Particles render in the WebGL frame, so
  a preview screenshot captures them (unlike the DOM HUD).
-->
<Scene xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../schema/scene.xsd">
  <Attachments>
    <Background color="#0a0e16" />
  </Attachments>
  <PerspectiveCamera id="cam" position="y: 2; z: 10" fov="45" near="0.1" far="200" fit="contain" />
  <AmbientLight intensity="0.7" />

  <!-- Full fire effect from a separate .particle.xml (its own grammar + XSD),
       referenced like a material. The cone emits along local +Z, so rotate the
       node -90° about X to aim it up (+Y). -->
  <Group id="fx" position="x: 0; y: 0; z: 0" eulerAngles="x: -90">
    <Components>
      <ParticleSystem src="../vfx/fire.particle.xml" />
    </Components>
  </Group>
</Scene>
