<!-- One brick, all three tiers.

     A level says how tough this one is with a single override — `<Override target="#brick"
     hits="2" />` — and the look follows: the three materials are named here once, and shared by
     every brick of that tier. -->
<Mesh id="body" geometry="../geometry/brick.asset.xml" material="../materials/brick-soft.asset.xml">
  <Components>
    <Brick id="brick" hits="1"
           soft="../materials/brick-soft.asset.xml"
           firm="../materials/brick-firm.asset.xml"
           hard="../materials/brick-hard.asset.xml" />
    <RigidBody2D kind="static" />
    <BoxCollider2D halfExtents="x: 1.2; y: 0.4" restitution="1" friction="0" />
  </Components>
</Mesh>
