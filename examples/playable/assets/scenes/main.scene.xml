<!-- A playable: one mechanic, twenty seconds, no menu.

     Tap the falling blocks. Twelve of them wins; five misses loses. Everything that decides the
     round is on <Round>, and everything that decides how it looks is here.

     Portrait first — <CameraFit mode="contain"> keeps the same 9 x 16 play area on any screen,
     so a phone in portrait and a landscape ad slot both frame the whole thing. -->
<Scene camera="#camera" background="#10131a">
  <Systems>
    <Round duration="20" target="12" allowedMisses="5" />
    <!-- Turns a tap into `onTap` on whatever is under it. -->
    <Pointer />
    <UIRenderer />
  </Systems>

  <AmbientLight color="#9db4d0" intensity="1.1" />
  <DirectionalLight color="#fff3dd" intensity="2.4" position="x: 4; y: 9; z: 6" />

  <PerspectiveCamera id="camera" near="0.1" far="100" position="z: 14">
    <Components>
      <CameraFit mode="contain" width="9" height="16" distance="14" />
    </Components>

    <Canvas>
      <Panel anchor="stretchTop" height="72" layout="horizontal" alignX="between"
             alignY="center" padding="18" background="#000000" opacity="0.35">
        <Text id="time" text="20" fontSize="30" color="#f0b429" />
        <Text id="score" text="0 / 12" fontSize="24" color="#e6edf6" />
      </Panel>

      <Panel anchor="center" width="300" height="80" layout="vertical" alignX="center" alignY="center">
        <Text id="banner" text="" fontSize="42" color="#ffffff" />
      </Panel>
    </Canvas>
  </PerspectiveCamera>

  <!-- The floor. Nothing collides with it; <Faller> just checks its own y. -->
  <Mesh geometry="../geometry/plane.asset.xml" material="../materials/ground.asset.xml"
        eulerAngles="x: -90" position="y: -6" scale="2" />

  <!-- Drops them in from above the frame. -->
  <Group id="spawner" position="y: 9">
    <Components>
      <Spawner spawns="target.prefab.xml" interval="0.9" finalInterval="0.45" spread="3.4" />
    </Components>
  </Group>

  <Group id="hud">
    <Components>
      <Hud timeText="#time" scoreText="#score" banner="#banner" />
    </Components>
  </Group>
</Scene>
