<!-- Collector: walk with the thumb stick, sweep up crates, run them to the pad in the middle.

     One mechanic, thirty seconds, no menu. Everything that decides the run is on <Run>; the
     level is a floor, a depot and a <Scatter> that keeps the crates topped up.

     The joystick lives on the camera, so it draws over the whole scene and is positioned in the
     camera's own space — see src/Joystick.ts for why it is nodes rather than UI. -->
<Scene camera="#camera" background="#0b1016">
  <Systems>
    <Run duration="30" quota="10" />
    <Collision />
    <UIRenderer />
  </Systems>

  <AmbientLight color="#9fb6d4" intensity="1.2" />
  <DirectionalLight color="#fff2d8" intensity="2.6" position="x: 6; y: 12; z: 5" />

  <!-- Looking down at the field from behind. <CameraFit> keeps the same 20 x 20 of level on
       screen whatever shape the ad slot is. -->
  <PerspectiveCamera id="camera" near="0.1" far="200" position="y: 15; z: 13" eulerAngles="x: -49">
    <Components>
      <CameraFit mode="contain" width="13" height="13" distance="20" />
      <Joystick id="stick" base="#stickBase" knob="#stickKnob" reach="70" />
    </Components>

    <Canvas>
      <!-- The stick. Two round panels the component moves under the thumb and turns off when
           nothing is held. `radius` is half the width, which is what makes a panel a circle. -->
      <Panel id="stickBase" anchor="topLeft" width="140" height="140" radius="70"
             background="#e8f0ff" opacity="0.16" />
      <Panel id="stickKnob" anchor="topLeft" width="58" height="58" radius="29"
             background="#ffffff" opacity="0.45" />

      <Panel anchor="stretchTop" height="76" layout="horizontal" alignX="between"
             alignY="center" padding="20" background="#000000" opacity="0.35">
        <Text id="time" text="30" fontSize="30" color="#f0b429" />
        <Text id="score" text="0 / 10" fontSize="24" color="#e6edf6" />
      </Panel>

      <Panel anchor="bottom" y="28" width="320" height="40" layout="vertical" alignX="center">
        <Text id="carry" text="" fontSize="20" color="#9fb6d4" />
      </Panel>

      <Panel anchor="center" width="360" height="80" layout="vertical" alignX="center" alignY="center">
        <Text id="banner" text="" fontSize="40" color="#ffffff" />
      </Panel>
    </Canvas>
  </PerspectiveCamera>

  <!-- The level. -->
  <Mesh geometry="../geometry/plane.geometry.xml" material="../materials/ground.material.xml"
        eulerAngles="x: -90" scale="1.3" />

  <!-- The drop-off, in the middle where every run passes through. -->
  <Mesh id="depot" geometry="../geometry/cylinder.geometry.xml"
        material="../materials/depot.material.xml" position="y: 0.05" scale="x: 3; y: 0.05; z: 3">
    <Components>
      <Depot />
      <SphereCollider radius="0.55" isSensor="true" />
    </Components>
  </Mesh>

  <Mesh id="player" geometry="../geometry/capsule.geometry.xml"
        material="../materials/player.material.xml" position="x: 3; y: 0.5; z: 3" scale="0.5">
    <Components>
      <Mover stick="#stick" speed="6" turn="720" bounds="x: 5.5; y: 0; z: 5.5" />
      <Carrier id="carrier" capacity="12" spacing="0.42" offset="0.55" />
      <SphereCollider radius="0.7" isSensor="true" />
    </Components>
  </Mesh>

  <Group id="crates">
    <Components>
      <Scatter crate="crate.prefab.xml" count="12" area="x: 5.2; y: 0; z: 5.2" clearance="2.2" />
    </Components>
  </Group>

  <Group id="hud">
    <Components>
      <Hud timeText="#time" scoreText="#score" carryText="#carry" banner="#banner" carrier="#carrier" />
    </Components>
  </Group>
</Scene>
