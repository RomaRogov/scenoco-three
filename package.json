{
  "name": "scenoco-workspace",
  "private": true,
  "version": "0.2.0",
  "description": "SceNoCo workspace (core + compiler + vite packages)",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "examples:dev": "vite --config examples/vite.config.ts",
    "examples:build": "vite build --config examples/vite.config.ts",
    "build": "npm run build:core && npm run build:compiler && npm run build:vite && npm run build:rapier && npm run build:box2d && npm run build:audio && npm run build:animation && npm run build:editor",
    "build:core": "npm --prefix packages/core run build",
    "build:compiler": "npm --prefix packages/compiler run build",
    "build:vite": "npm --prefix packages/vite run build",
    "build:rapier": "npm --prefix packages/rapier run build",
    "build:box2d": "npm --prefix packages/box2d run build",
    "build:audio": "npm --prefix packages/audio run build",
    "build:animation": "npm --prefix packages/animation run build",
    "build:editor": "npm --prefix packages/editor run build",
    "export": "npm run build:compiler && node packages/compiler/dist/cli/index.js export --out schema",
    "typecheck": "npm run typecheck:core && npm run typecheck:compiler && npm run typecheck:vite && npm run typecheck:rapier && npm run typecheck:box2d && npm run typecheck:audio && npm run typecheck:animation && npm run typecheck:editor && tsc --noEmit -p tsconfig.json",
    "typecheck:core": "npm --prefix packages/core run typecheck",
    "typecheck:compiler": "npm --prefix packages/compiler run typecheck",
    "typecheck:vite": "npm --prefix packages/vite run typecheck",
    "typecheck:rapier": "npm --prefix packages/rapier run typecheck",
    "typecheck:box2d": "npm --prefix packages/box2d run typecheck",
    "typecheck:audio": "npm --prefix packages/audio run typecheck",
    "typecheck:animation": "npm --prefix packages/animation run typecheck",
    "typecheck:editor": "npm --prefix packages/editor run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/three": "^0.184.1",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-arm64-gnu": "^1.1.1"
  }
}
