{
  "name": "scenoco-workspace",
  "private": true,
  "version": "0.9.6",
  "description": "Unity's behaviours on three.js, with scenes written in TSX and no React.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "workspaces": [
    "packages/core",
    "packages/box2d",
    "packages/rapier",
    "packages/particles",
    "packages/audio",
    "packages/splines",
    "packages/terrain",
    "packages/observer",
    "packages/unity",
    "packages/tools",
    "packages/create",
    "packages/editor"
  ],
  "scripts": {
    "examples:dev": "npm --prefix examples/breakout run dev",
    "examples:build": "npm --prefix examples/breakout run build",
    "build": "npm run build:core && npm run build:box2d && npm run build:rapier && npm run build:particles && npm run build:audio && npm run build:splines && npm run build:terrain && npm run build:observer && npm run build:tools && npm run build:unity && npm run build:editor",
    "build:core": "npm --prefix packages/core run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix examples/breakout run check && npm --prefix examples/home run check && npm --prefix examples/race run check && npm --prefix examples/td run check && npm --prefix packages/create/template run check && npm --prefix examples/subway run check && npm --prefix examples/eggy run check",
    "typecheck:core": "npm --prefix packages/core run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "build:box2d": "npm --prefix packages/box2d run build",
    "build:rapier": "npm --prefix packages/rapier run build",
    "build:particles": "npm --prefix packages/particles run build",
    "build:audio": "npm --prefix packages/audio run build",
    "build:splines": "npm --prefix packages/splines run build",
    "build:terrain": "npm --prefix packages/terrain run build",
    "build:observer": "npm --prefix packages/observer run build",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "build:tools": "npm --prefix packages/tools run build",
    "build:editor": "npm --prefix packages/editor run build",
    "build:unity": "npm --prefix packages/unity run build",
    "site": "node scripts/site.mjs",
    "discovery": "node scripts/discovery.mjs"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "~0.20.0",
    "@types/node": "^25.9.3",
    "@types/three": "^0.184.1",
    "playwright-core": "^1.62.1",
    "three": "^0.184.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-arm64-gnu": "^1.1.1"
  }
}
