{
  "name": "@scenoco-three/unity",
  "version": "1.0.0",
  "description": "Export a SceNoCo game's prefabs, scenes, meshes and materials into a Unity project: nested prefabs, shared materials, behaviours as MonoBehaviours with their fields wired.",
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "game-engine",
    "game-framework",
    "gamedev",
    "web-game",
    "webgl",
    "typescript",
    "unity",
    "unity-export",
    "prefab",
    "porting"
  ],
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/unity#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/unity"
  },
  "bin": {
    "scenoco-unity": "dist/cli.js"
  },
  "main": "./dist/export.js",
  "types": "./dist/export.d.ts",
  "exports": {
    ".": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    }
  },
  "files": [
    "dist",
    "unity"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "playwright-core": "^1.62.1",
    "rolldown": "^1.0.3"
  },
  "peerDependencies": {
    "@scenoco-three/core": "^1.0.0",
    "vite": ">=6"
  }
}
