{
  "name": "@scenoco-three/tools",
  "version": "0.9.9",
  "description": "SceNoCo's tools: `scenoco check` (a .tsx scene only declares), the `scenoco()` Vite plugin, and the read/edit layer the editor uses on scene files.",
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "game-engine",
    "game-framework",
    "gamedev",
    "web-game",
    "webgl",
    "typescript",
    "unity",
    "tsx",
    "vite-plugin",
    "cli",
    "lint"
  ],
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/tools#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/tools"
  },
  "bin": {
    "scenoco": "bin/scenoco.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/editor": "^0.9.9",
    "launch-editor": "^2.14.2",
    "rolldown": "^1.0.3"
  },
  "peerDependencies": {
    "typescript": ">=7",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
