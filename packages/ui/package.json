{
  "name": "@scenoco-three/ui",
  "version": "0.4.0",
  "description": "In-canvas UI for SceNoCo: flexbox <Fullscreen>/<Container>/<Text>/<Image> scene tags rendered by pmndrs uikit",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "ui",
    "uikit",
    "flexbox",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/core": "^0.4.0",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/pointer-events": "^6.6.30"
  },
  "peerDependencies": {
    "three": ">=0.182"
  }
}
