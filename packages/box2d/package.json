{
  "name": "@scenoco-three/box2d",
  "version": "0.6.0",
  "description": "2D physics for SceNoCo on planck (Box2D): a Physics2D system, RigidBody2D, and the collider shapes.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/box2d"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/box2d#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "three",
    "threejs",
    "physics",
    "2d",
    "box2d",
    "planck",
    "scene",
    "components",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "//sideEffects": "contacts.ts merges the Unity-style contact hooks onto Component — a declaration-only import a bundler could otherwise elide. Everything else is pure.",
  "sideEffects": true,
  "scenoco": {},
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/core": "^0.6.0",
    "planck": "^1.5.0"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  }
}
