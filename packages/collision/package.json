{
  "name": "@scenoco-three/collision",
  "version": "0.4.0",
  "description": "Detection-only collision for SceNoCo, API-identical to @scenoco-three/rapier.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/contacts.js",
    "./src/contacts.ts"
  ],
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "collision",
    "trigger",
    "overlap",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/core": "^0.4.0"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  }
}
