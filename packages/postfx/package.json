{
  "name": "@scenoco-three/postfx",
  "version": "0.6.0",
  "description": "Render settings and post-processing effects for SceNoCo: ToneMapping, Shadows, Bloom, Vignette.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/postfx"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/postfx#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "postprocessing",
    "bloom",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scenoco": {},
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/core": "^0.6.0"
  },
  "peerDependencies": {
    "three": ">=0.182"
  }
}
