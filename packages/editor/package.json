{
  "name": "@scenoco-three/editor",
  "version": "0.5.0",
  "description": "Local visual editor for SceNoCo scenes, with an observation-only MCP server so an agent can see and drive the same live scene.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/editor#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "bin": {
    "scenoco-editor": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "app"
  ],
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "editor",
    "preview",
    "render",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "typecheck": "npm --prefix ../core run build && npm --prefix ../compiler run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@scenoco-three/compiler": "^0.5.0",
    "@scenoco-three/core": "^0.5.0",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-arborist": "^3.4.0",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.5.13"
  }
}