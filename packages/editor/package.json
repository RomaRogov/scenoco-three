{
  "name": "@scenoco-three/editor",
  "version": "0.7.0",
  "description": "The SceNoCo editor: opened on a game's own dev server with ?edit — a tree, an inspector and gizmos over the live scene, writing back to the .tsx files byte for byte.",
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "game-engine",
    "game-framework",
    "gamedev",
    "web-game",
    "webgl",
    "typescript",
    "unity",
    "editor",
    "level-editor",
    "inspector",
    "gizmo",
    "tsx"
  ],
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/editor#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/editor"
  },
  "bin": {
    "scenoco-editor": "bin/serve.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-arborist": "^3.4.0",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  }
}
