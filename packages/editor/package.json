{
  "name": "@scenoco-three/editor",
  "version": "0.4.0",
  "description": "Local visual editor + MCP server for SceNoCo scenes/prefabs (for multimodal LLMs)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "scenoco-editor": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "app"
  ],
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "editor",
    "preview",
    "render",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "typecheck": "npm --prefix ../core run build && npm --prefix ../compiler run build && npm --prefix ../vite run build && npm run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@scenoco-three/compiler": "^0.4.0",
    "@scenoco-three/vite": "^0.4.0",
    "@vitejs/plugin-react": "^6.0.3",
    "chokidar": "^4.0.3",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-arborist": "^3.15.0",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@scenoco-three/core": "^0.4.0",
    "three": ">=0.160",
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.5.13"
  }
}
