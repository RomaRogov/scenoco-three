{
  "name": "@scenoco-three/particles",
  "version": "0.4.0",
  "description": "Particle systems / VFX for SceNoCo: a Unity-style <ParticleSystem> component + emission/shape/over-lifetime modules, rendered by three.quarks",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "particle.xsd"
  ],
  "sideEffects": true,
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "particles",
    "particle-system",
    "vfx",
    "three.quarks",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/core": "^0.4.0",
    "three.quarks": "^0.17.1"
  },
  "peerDependencies": {
    "three": ">=0.182"
  }
}
