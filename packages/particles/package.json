{
  "name": "@scenoco-three/particles",
  "version": "0.7.0",
  "description": "Particle effects for SceNoCo on three.quarks: Unity's ParticleSystem playing typed ParticleEffect data.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/particles"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/particles#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "particles",
    "particle-system",
    "vfx",
    "three.quarks",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/core": "^0.7.0",
    "three.quarks": "^0.17.1"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
