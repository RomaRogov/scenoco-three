{
  "name": "@scenoco-three/particles",
  "version": "0.6.0",
  "description": "Particle systems / VFX for SceNoCo: a Unity-style <ParticleSystem> component playing .particle.xml effects, batched by three.quarks",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/particles"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/particles#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "sideEffects": true,
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "particles",
    "particle-system",
    "vfx",
    "three.quarks",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scenoco": {
    "documents": [
      {
        "extension": ".particle.xml",
        "type": "ParticleEffect",
        "dir": "assets/vfx",
        "description": "A particle effect, in Unity Shuriken module form",
        "template": "./templates/particle.xml"
      }
    ],
    "previews": {
      "ParticleSystem": "./dist/particle.preview.js"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && npm run build:preview",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit -p tsconfig.json",
    "build:preview": "esbuild src/preview.ts --bundle --format=esm --platform=browser --external:three --outfile=dist/particle.preview.js --log-level=warning"
  },
  "dependencies": {
    "@scenoco-three/core": "^0.6.0",
    "three.quarks": "^0.17.1"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  }
}
