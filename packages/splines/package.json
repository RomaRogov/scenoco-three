{
  "name": "@scenoco-three/splines",
  "version": "0.9.5",
  "description": "Splines for SceNoCo: Unity-shaped SplineContainer, SplineMesh, SplineExtrude, SplineInstantiate and SplineAnimate on three.js — roads, rails and paths.",
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "game-engine",
    "game-framework",
    "gamedev",
    "web-game",
    "webgl",
    "typescript",
    "unity",
    "spline",
    "bezier",
    "curve",
    "road",
    "extrude",
    "path"
  ],
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/splines#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/splines"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/core": "^0.9.5"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  }
}
