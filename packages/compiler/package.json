{
  "name": "@scenoco-three/compiler",
  "version": "0.6.1",
  "description": "Build-time half of SceNoCo: finds components by scanning the workspace and reads their serialized fields from the TypeScript source.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/compiler#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "compiler",
    "codegen",
    "xml",
    "dsl",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "typescript": "^7.0.2",
    "saxes": "^6.0.0"
  },
  "//peerDependencies": "three is read, not bundled: the tag vocabulary comes from its declarations and the colour diagnostics from its own parser. A project compiling SceNoCo documents has it by definition.",
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "bin": {
    "scenoco": "./dist/bin.js"
  }
}
