{
  "name": "@scenoco-three/animation",
  "version": "0.2.0",
  "description": "Animation for SceNoCo: a declarative <Tween> component (easing/looping) + a reusable Tween class, and an <Animator> that plays a model's glTF clips",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "animation",
    "tween",
    "tweening",
    "easing",
    "animator",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm --prefix ../core run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/core": "^0.2.0"
  },
  "peerDependencies": {
    "three": ">=0.160"
  }
}
