{
  "name": "@scenoco-three/core",
  "version": "0.7.0",
  "description": "SceNoCo core: Unity's behaviours on three.js \u2014 Behaviour, coroutines, Time, Input, SceneManager \u2014 with scenes written in TSX and no React.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/core#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js"
    }
  },
  "files": [
    "dist",
    "API.md"
  ],
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "component",
    "scene-graph",
    "game-engine",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": true,
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  }
}
