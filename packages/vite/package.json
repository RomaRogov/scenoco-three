{
  "name": "@scenoco-three/vite",
  "version": "0.6.0",
  "description": "Vite plugin for SceNoCo XML scene bundling",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/vite#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "three",
    "threejs",
    "vite",
    "vite-plugin",
    "scene",
    "components",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm --prefix ../core run build && npm --prefix ../compiler run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@scenoco-three/compiler": "^0.6.0"
  },
  "peerDependencies": {
    "vite": ">=8",
    "typescript-transform": ">=6"
  },
  "peerDependenciesMeta": {
    "typescript-transform": {
      "optional": true
    }
  }
}
