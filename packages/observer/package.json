{
  "name": "@scenoco-three/observer",
  "version": "0.9.0",
  "description": "The running SceNoCo game from a test: observe(page) holds and steps the game clock, drives input, waits for conditions and reads behaviours back on any Playwright or Puppeteer page.",
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "game-engine",
    "game-framework",
    "gamedev",
    "web-game",
    "webgl",
    "typescript",
    "unity",
    "ai-agent",
    "playwright",
    "testing"
  ],
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/observer#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/observer"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
