{
  "name": "@scenoco-three/observer",
  "version": "0.7.0",
  "description": "An agent's eyes on a SceNoCo game: an MCP server over stdio that runs the project's own Vite dev server in a headless Chrome it owns, holds and steps the game clock, drives input, and reads behaviours back as text.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/observer"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/observer#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "bin": {
    "scenoco-observer": "./dist/cli.js"
  },
  "main": "./dist/mcp.js",
  "types": "./dist/mcp.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "mcp",
    "agent",
    "observer",
    "screenshot",
    "simulate",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright-core": "^1.62.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  }
}
