{
  "name": "@scenoco-three/observer",
  "version": "0.6.1",
  "description": "An agent's eyes on a SceNoCo scene: an MCP server over stdio that compiles the project, runs the scene in a headless Chrome it owns, renders it from stated viewpoints, drives it frame by frame, and reads it back as text.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomaRogov/scenoco-three.git",
    "directory": "packages/observer"
  },
  "homepage": "https://github.com/RomaRogov/scenoco-three/tree/main/packages/observer#readme",
  "bugs": "https://github.com/RomaRogov/scenoco-three/issues",
  "bin": {
    "scenoco-observer": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "app"
  ],
  "keywords": [
    "three",
    "threejs",
    "scenoco",
    "mcp",
    "agent",
    "observer",
    "screenshot",
    "simulate",
    "gamedev"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "typecheck": "npm --prefix ../core run build && npm --prefix ../compiler run build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@scenoco-three/compiler": "^0.6.0",
    "@scenoco-three/core": "^0.6.0",
    "playwright-core": "^1.62.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "vite": ">=8"
  },
  "devDependencies": {}
}
