# Dependencies
node_modules/
# The workspace lockfile is committed on purpose: CI resolves from the registry otherwise, so a
# package published upstream can break a build that changed nothing. One did — a new major of an
# optional peer of vitest crashed npm's resolver on a commit that only bumped versions. The
# nested ones stay out: each of those projects is installed on its own, deliberately.
package-lock.json
!/package-lock.json

# Build output / artifacts
dist/
demo/
schema/
*.log

# Compiled documents. A `.gen.ts` sits beside the `.xml` it came from and is rewritten on every
# build — the XML is the source of truth, so committing both would mean reviewing the same change
# twice and resolving conflicts in generated code.
*.gen.ts

# OS / editor
.DS_Store

# Tooling caches & local config (not published)
.claude/
.scenoco/
.playwright-mcp/

# Working notes, kept local. What is public is the README of each package and AGENTS.md.
docs/
agentic/

# Other agents' local config
.aider.conf.yml
.clinerules

