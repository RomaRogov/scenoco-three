<!-- The yard: an arena, ten crates, a depot pad in the middle, sixty seconds.
     Every number here is normative — see bench/PARITY.md. -->
<Scene camera="#camera" background="#0d1117">
  <PerspectiveCamera id="camera" fov="50" near="0.1" far="200"
                     position="y: 14; z: 14" eulerAngles="x: -45" />

  <AmbientLight color="#9fb4d0" intensity="0.9" />
  <DirectionalLight color="#fff6e8" intensity="2.1" position="x: 6; y: 16; z: 8" />

  <!-- The floor, laid flat. Its top surface is y = 0, which every other height is measured from. -->
  <Mesh geometry="../geometry/ground.geometry.xml" material="../materials/ground.material.xml"
        name="ground" eulerAngles="x: -90" />

  <!-- Four walls, 1 tall, centred half a thickness outside the floor's edge. -->
  <Mesh geometry="../geometry/wall.geometry.xml" material="../materials/wall.material.xml" name="wall"
        position="y: 0.5; z: -10.25" />
  <Mesh geometry="../geometry/wall.geometry.xml" material="../materials/wall.material.xml" name="wall"
        position="y: 0.5; z: 10.25" />
  <Mesh geometry="../geometry/wall.geometry.xml" material="../materials/wall.material.xml" name="wall"
        position="x: -10.25; y: 0.5" eulerAngles="y: 90" />
  <Mesh geometry="../geometry/wall.geometry.xml" material="../materials/wall.material.xml" name="wall"
        position="x: 10.25; y: 0.5" eulerAngles="y: 90" />

  <Mesh id="depot" name="depot" geometry="../geometry/depot.geometry.xml"
        material="../materials/depot.material.xml" position="y: 0.05" />

  <!-- The capsule stands on the floor: half its height above it. -->
  <Mesh id="player" name="player" geometry="../geometry/player.geometry.xml"
        material="../materials/player.material.xml" position="y: 0.8; z: 6">
    <Components>
      <Player />
      <Carrier />
    </Components>
  </Mesh>

  <!-- The round's clock and counters. A Unity project would call this the GameManager. -->
  <Group id="round">
    <Components>
      <Round duration="60" />
    </Components>
  </Group>

  <!-- Ten crates. Ten placements rather than a loop: each position is a checked vector, and a
       typo in one is a build error at its own line. -->
  <Prefab src="crate.prefab.xml" position="x: -6; y: 0.3; z: -6" />
  <Prefab src="crate.prefab.xml" position="x: -3; y: 0.3; z: 5" />
  <Prefab src="crate.prefab.xml" position="x: 2; y: 0.3; z: 7" />
  <Prefab src="crate.prefab.xml" position="x: 6; y: 0.3; z: 3" />
  <Prefab src="crate.prefab.xml" position="x: 7; y: 0.3; z: -4" />
  <Prefab src="crate.prefab.xml" position="x: -7; y: 0.3; z: 2" />
  <Prefab src="crate.prefab.xml" position="x: 4; y: 0.3; z: -7" />
  <Prefab src="crate.prefab.xml" position="x: -2; y: 0.3; z: -8" />
  <Prefab src="crate.prefab.xml" position="x: 8; y: 0.3; z: 6" />
  <Prefab src="crate.prefab.xml" position="x: -8; y: 0.3; z: -2" />
</Scene>
