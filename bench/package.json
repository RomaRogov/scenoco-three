{
  "name": "scenoco-bench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install:arms": "for a in arms/*/; do npm --prefix \"$a\" install; done",
    "build:arms": "for a in arms/*/; do npm --prefix \"$a\" run check; done",
    "oracle": "vitest run",
    "bench": "node --experimental-strip-types src/cli.ts",
    "watch": "opencode serve --port 4096 --hostname 127.0.0.1"
  },
  "devDependencies": {
    "vitest": "^4.1.8",
    "three": "^0.184.0",
    "typescript": "^7.0.0"
  }
}
